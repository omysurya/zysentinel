# Notifikasi Sentinel
#
# Dibaca oleh /www/server/sentinel/bin/sentinel-notify.sh setiap
# 10 detik oleh systemd timer. Jangan diisi dengan nilai yang tidak
# benar-benar URL, karena skrip akan tetap mencoba dan selalu gagal.
#
# NOTIFY_URL kosong berarti notifikasi dimatikan. Ini keadaan bawaan.
# Isi kalau dan hanya kalau Anda benar-benar ingin diberi tahu.

# Alamat tujuan. Contoh untuk Telegram:
#   https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>
# Contoh untuk webhook biasa yang menerima JSON:
#   https://contoh.anda/webhook/sentinel
# Contoh untuk ntfy (tidak butuh token):
#   https://ntfy.sh/sentinel-notifikasi
NOTIFY_URL=""

# Token bearer opsional. Dikirim sebagai header Authorization.
# Hanya dipakai kalau layanan tujuan memang memerlukannya.
# PERINGATAN: nilai ini setara kata sandi. Jangan menuliskannya di
# dokumen, jangan dibagikan, dan lihat siapa saja yang bisa membaca
# file ini: chmod 600.
NOTIFY_TOKEN=""

# notifikasi mana yang dikirim: semua, ban, atau throttle
NOTIFY_KIND="semua"

# Batas percobaan sebelum baris dianggap gagal permanen dan tidak
# dicoba lagi. Mencegah antrean tumbuh tanpa batas kalau alamat
# tujuan memang salah terus.
SENTINEL_NOTIF_MAX="5"

# Berapa banyak notifikasi dikirim per siklus.
SENTINEL_NOTIF_BATCH="20"

# Batas waktu menunggu jawaban, dalam detik.
SENTINEL_NOTIF_TIMEOUT="8"
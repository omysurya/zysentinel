# ZySentinel: sesuaikan konektor Coraza dengan versi nginx aktif setelah nginx di-upgrade (dijadwalkan oleh `sentinel-waf.sh nginx-prestart`
# dari drop-in nginx.service, atau oleh guard). Compile prioritas rendah, uji terisolasi, baru dimuat; situs tidak pernah memakai konfigurasi
# yang gagal nginx -t. Tanpa [Install]: hanya dijalankan sesuai kebutuhan.
[Unit]
Description=ZySentinel: sesuaikan konektor Coraza dengan versi nginx aktif
After=nginx.service network-online.target

[Service]
Type=oneshot
ExecStart=/www/server/sentinel/bin/sentinel-waf.sh coraza-sesuaikan
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=3600

# Sandbox (14 Nov 2026): membatasi apa yang bisa dilakukan proses ini bila disusupi (tanpa memuat modul kernel, tanpa
# namespace baru, tanpa mengubah jam/hostname, syscall berbahaya ditolak). Hak root yang dibutuhkan fitur tetap ada.
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_BOOT CAP_SYS_TIME CAP_WAKE_ALARM CAP_MKNOD CAP_SYS_RAWIO CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_BLOCK_SUSPEND CAP_LEASE CAP_AUDIT_CONTROL CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYSLOG
SystemCallFilter=~@cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
# Compile konektor dan menulis konfigurasi nginx (standalone /etc/nginx, drop-in nginx.service.d): sistem berkas tidak dibatasi.
ProtectKernelTunables=true

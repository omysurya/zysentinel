[Unit]
Description=ZySentinel Real-Time Upload Scanner & Per-Host Quarantine Guard (Imunify360 Style)
After=network.target sentinel.service clamav-daemon.service
Wants=sentinel.service clamav-daemon.service

[Service]
Type=simple
ExecStart=/www/server/panel/pyenv/bin/python3 /www/server/sentinel/bin/sentinel-upload-scan.py daemon
Restart=always
RestartSec=5
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
MemoryHigh=192M
CPUQuota=50%
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZySentinel Realtime Upload Protection (pemindai upload, gerbang eksekusi, karantina per vhost)
After=network.target sentinel.service clamav-daemon.service
Wants=sentinel.service clamav-daemon.service

[Service]
Type=simple
ExecStart=/www/server/panel/pyenv/bin/python3 /www/server/sentinel/bin/sentinel-upload-scan.py daemon
Restart=always
RestartSec=1
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=2
MemoryMax=256M
MemoryHigh=192M
CPUQuota=100%
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

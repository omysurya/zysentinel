[Unit]
Description=Sentinel guardd (monitoring dan klasifikasi serangan)
Documentation=https://github.com/omysurya/zysentinel
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=900
StartLimitBurst=6

[Service]
Type=simple
ExecStart=/www/server/sentinel/bin/guardd -c /www/server/sentinel/etc/guardd.conf
ExecReload=/bin/kill -HUP $MAINPID
# Pemulihan crash dengan jeda makin panjang (2 dtk naik bertahap ke 60 dtk), lalu BERHENTI setelah 6 kali
# dalam 15 menit (unit jadi failed). sentinel-selfheal melanjutkan dengan jeda 2, 5, 10, 20, 40, 60 menit dan
# paling banyak 12 percobaan per 24 jam, jadi tidak ada putaran restart tanpa akhir yang membanjiri CPU dan log.
Restart=on-failure
# 0 = daemon yang menangkap SIGTERM lalu keluar bersih (kill dari luar) tetap dipulihkan; systemctl stop tidak terpengaruh
RestartForceExitStatus=0 SIGTERM SIGHUP SIGINT SIGPIPE
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=60
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
# batas keras: kalau daemon membengkak, restart lebih baik
# daripada zajamnya sampai server kehabisan memori
MemoryMax=256M
LimitNOFILE=65536
# direktori kerja /www supaya path relatif tidak salah
WorkingDirectory=/www

# Pengetatan minimal. Daemon hanya butuh menulis ke direktori miliknya
# sendiri dan membaca log nginx.
PrivateTmp=true
ProtectSystem=full
# read-only (15 Nov 2026): CyberPanel menulis access log situs di /home/<situs>/logs; dulu tersembunyi sehingga guardd buta terhadap
# serangan ke situs CyberPanel. guardd hanya membaca log.
ProtectHome=read-only
ProtectKernelTunables=true
ReadWritePaths=/www/server/sentinel

# Sandbox (14 Nov 2026): membatasi apa yang bisa dilakukan proses ini bila disusupi (tanpa memuat modul kernel, tanpa
# namespace baru, tanpa mengubah jam/hostname, syscall berbahaya ditolak). Hak root yang dibutuhkan fitur tetap ada.
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_BOOT CAP_SYS_TIME CAP_WAKE_ALARM CAP_MKNOD CAP_SYS_RAWIO CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_BLOCK_SUSPEND CAP_LEASE CAP_AUDIT_CONTROL CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYSLOG
SystemCallFilter=~@cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

StandardOutput=append:/www/server/sentinel/log/guardd.out
StandardError=append:/www/server/sentinel/log/guardd.out

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZySentinel Sweeper (pemindaian webshell terjadwal semua vhost dan folder kustom)
After=network.target
# Hanya berjalan bila operator menyalakan jadwal di panel (berkas bendera dibuat/dihapus oleh Sweeper).
ConditionPathExists=/www/server/sentinel/etc/sweeper.schedule

[Service]
Type=oneshot
ExecStart=/www/server/panel/pyenv/bin/python3 /www/server/sentinel/bin/sentinel-sweeper.py scan --all-vhosts --scheduled
# Hemat sumber daya: prioritas rendah, IO idle, batas CPU dan memori. Mesin C memakai belasan MB.
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
TimeoutStartSec=4h
StandardOutput=null
StandardError=journal

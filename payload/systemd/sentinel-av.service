[Unit]
Description=ZySentinel Antivirus scheduled scan
Documentation=https://github.com/omysurya/zysentinel
After=network.target clamav-daemon.service sentinel.service

[Service]
Type=oneshot
# edisi Free: pemindaian terjadwal seluruh situs (av_scheduled) adalah fitur Pro; hanya integritas sistem yang diperiksa
ExecStart=/www/server/sentinel/bin/sentinel-av.sh check-sys
RemainAfterExit=no

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

TimeoutStartSec=2h
User=root

StandardOutput=append:/www/server/sentinel/log/av.log
StandardError=append:/www/server/sentinel/log/av.log

[Install]
WantedBy=multi-user.target

[Unit]
Description=ZySentinel Antivirus scheduled scan
Documentation=https://github.com/omysurya/zysentinel
After=network.target clamav-daemon.service sentinel.service

[Service]
Type=oneshot
# edisi Free: pemindaian terjadwal seluruh situs (av_scheduled) adalah fitur Pro; hanya integritas sistem yang diperiksa
ExecStart=/www/server/sentinel/bin/sentinel-av.sh check-sys
RemainAfterExit=no

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

TimeoutStartSec=2h
User=root

# Sandbox (14 Nov 2026): membatasi apa yang bisa dilakukan proses ini bila disusupi (tanpa memuat modul kernel, tanpa
# namespace baru, tanpa mengubah jam/hostname, syscall berbahaya ditolak). Hak root yang dibutuhkan fitur tetap ada.
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_BOOT CAP_SYS_TIME CAP_WAKE_ALARM CAP_MKNOD CAP_SYS_RAWIO CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_BLOCK_SUSPEND CAP_LEASE CAP_AUDIT_CONTROL CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYSLOG
SystemCallFilter=~@cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
# Pindai webroot (karantina bisa menulis di webroot, termasuk /home); daftar berkas sementara di /tmp privat.
ProtectSystem=full
ProtectKernelTunables=true
PrivateTmp=true

StandardOutput=append:/www/server/sentinel/log/av.log
StandardError=append:/www/server/sentinel/log/av.log

[Install]
WantedBy=multi-user.target

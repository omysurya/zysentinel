[Unit]
Description=ZySentinel Global Threat Intelligence Feed Ingestion
Documentation=file:/www/docs/
After=network.target sentinel-fw.service

[Service]
Type=oneshot
ExecStart=/www/server/sentinel/bin/sentinel-intel.sh update
RemainAfterExit=no

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

TimeoutStartSec=120
User=root

StandardOutput=append:/www/server/sentinel/log/intel.log
StandardError=append:/www/server/sentinel/log/intel.log

[Install]
WantedBy=multi-user.target

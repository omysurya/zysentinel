[Unit]
Description=Kirim notifikasi Sentinel setiap 10 detik

[Timer]
# 10 detik. Jeda ini bukan pilihan asal, ada alasannya.
#
# Interval 5 menit seperti sentinel-fw.timer jelas terlalu kasar untuk
# pemberitahuan. Tapi daemon membaca log setiap 2 detik, dan satu
# alamat tujuan yang tidak menjawab akan menahan pengirim selama
# timeout-nya. Kalau jeda terlalu rapat, notifikasi menumpuk sendiri.
#
# 10 detik memberi jarak yang cukup bagi pengirim yang sedang
# menunggu timeout, dan memberi operator waktu yang masuk akal.
OnBootSec=30
OnUnitActiveSec=10
AccuracySec=2s
Unit=sentinel-notify.service

[Install]
WantedBy=timers.target
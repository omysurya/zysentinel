[Unit]
Description=ZySentinel integritas berkas web dan persistensi sistem (anti-tamper)
Documentation=file:/www/docs/
After=sentinel.service

[Service]
Type=oneshot
# Vhost tanpa baseline dibuatkan baseline; vhost lain diperiksa dan perubahan BARU
# (tambah/ubah/hapus .php, .phar, .htaccess, .user.ini, ...) diantrekan sebagai notifikasi.
ExecStart=/www/server/sentinel/bin/sentinel-av.sh check-all
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
TimeoutStartSec=30min
User=root
StandardOutput=append:/www/server/sentinel/log/integ.log
StandardError=append:/www/server/sentinel/log/integ.log

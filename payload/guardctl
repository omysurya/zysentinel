# Interpreter ZySentinel (dipilih installer, lihat etc/python): bin/py hanya berisi symlink python3, mis. ke python3.9 di EL8.
# Tanpa bin/py (instalasi lama) perilaku tidak berubah: python3 dari PATH sistem.
PATH="/www/server/sentinel/bin/py:$PATH"
# ============================================================
# guardctl -- kendali baris perintah untuk guardd
#
# Semua perintah jalan lewat unix socket. Bila guardd mati, perintah
# yang butuh daemon akan memberi tahu, bukan diam-diam berhasil.
# ============================================================
set -u

RUNDIR="${SENTINEL_RUN:-/www/server/sentinel/run}"
SOCK="${SENTINEL_SOCK:-$RUNDIR/guardd.sock}"
CONF="${SENTINEL_CONF:-/www/server/sentinel/etc/guardd.conf}"
PIDFILE="$RUNDIR/guardd.pid"
STATUSJSON="$RUNDIR/status.json"

LANGFILE="${SENTINEL_ETC:-/www/server/sentinel/etc}/lang.json"

get_lang() {
  local l="en"
  if [ -f "$LANGFILE" ]; then
    l="$(grep -o '"lang"[[:space:]]*:[[:space:]]*"[^"]*"' "$LANGFILE" 2>/dev/null | cut -d'"' -f4)"
  fi
  [ "$l" = "id" ] && printf "id" || printf "en"
}

say() { printf '%s\n' "$*"; }
err() {
  if [ "$(get_lang)" = "id" ]; then
    printf 'GALAT: %s\n' "$*" >&2
  else
    printf 'ERROR: %s\n' "$*" >&2
  fi
}

is_systemd() {
  [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1
}

# Stop bersifat SINKRON: guardd butuh beberapa detik untuk menutup diri. Tanpa menunggu, "start" berikutnya
# ditolak kunci instans (.guardd.lock) lalu proses lama keluar = tidak ada daemon sama sekali, dan uninstall
# menghapus berkas/aturan di bawah daemon yang masih hidup. Tunggu hingga 10 detik, lalu SIGTERM, lalu SIGKILL.
guardd_pids() {  # hanya guardd milik Sentinel (biner di .../sentinel/..., juga bila sudah terhapus: "(deleted)")
  local p
  for p in $(pgrep -x guardd 2>/dev/null); do
    case "$(readlink "/proc/$p/exe" 2>/dev/null)" in */sentinel/*) printf '%s ' "$p";; esac
  done
}
tunggu_keluar() {  # tunggu_keluar <jumlah langkah 0,2 detik>
  local i=0
  while [ "$i" -lt "$1" ]; do
    [ -z "$(guardd_pids)" ] && return 0
    sleep 0.2; i=$((i + 1))
  done
  [ -z "$(guardd_pids)" ]
}
pastikan_berhenti() {
  tunggu_keluar 50 && return 0
  # shellcheck disable=SC2046
  kill $(guardd_pids) 2>/dev/null
  tunggu_keluar 25 && return 0
  # shellcheck disable=SC2046
  kill -9 $(guardd_pids) 2>/dev/null
  if [ "$(get_lang)" = "id" ]; then say "guardd tidak menutup diri; dihentikan paksa (SIGKILL)"; else say "guardd did not exit; force-killed (SIGKILL)"; fi
  tunggu_keluar 10
}

ctl() {
  if [ ! -S "$SOCK" ]; then
    if [ "$(get_lang)" = "id" ]; then
      err "socket daemon tidak ada ($SOCK), guardd belum jalan"
    else
      err "daemon socket not found ($SOCK), guardd is not running"
    fi
    return 1
  fi
  local reply=""
  if command -v nc >/dev/null 2>&1; then
    reply="$(printf '%s' "$1" | timeout 5 nc -U -q1 "$SOCK" 2>/dev/null)"
  fi
  if [ -z "$reply" ] && command -v socat >/dev/null 2>&1; then
    reply="$(printf '%s' "$1" | timeout 5 socat - "UNIX-CONNECT:$SOCK" 2>/dev/null)"
  fi
  local py_bin=""
  if command -v python3 >/dev/null 2>&1; then
    py_bin="python3"
  elif [ -x /www/server/panel/pyenv/bin/python3 ]; then
    py_bin="/www/server/panel/pyenv/bin/python3"
  fi
  if [ -z "$reply" ] && [ -n "$py_bin" ]; then
    reply="$("$py_bin" -c "import socket, sys; s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(5); s.connect('$SOCK'); s.sendall(sys.argv[1].encode()); print(s.recv(4096).decode('utf-8', errors='ignore').strip())" "$1" 2>/dev/null)"
  fi
  if [ -z "$reply" ]; then
    if [ "$(get_lang)" = "id" ]; then
      err "tidak ada balasan dari guardd"
    else
      err "no response from guardd"
    fi
    return 1
  fi
  if [ "$(get_lang)" = "en" ]; then
    reply="${reply//\"err\":\"ip tidak valid\"/\"err\":\"invalid IP address\"}"
    reply="${reply//\"err\":\"ip ada di allowlist\"/\"err\":\"IP address is in allowlist\"}"
    reply="${reply//\"err\":\"perintah tidak dikenal\"/\"err\":\"unknown command\"}"
  fi
  say "$reply"
  case "$reply" in *'"ok":true'*) return 0 ;; *) return 1 ;; esac
}

# --- UI standalone (Pro/Max): kendali layanan sentinel-ui + sentinel-uid ---
UI_ETC=/etc/zysentinel-ui
UI_STATIC=/usr/share/zysentinel-ui
UI_PORT=18491
ui_pesan() { if [ "$(get_lang)" = "id" ]; then say "$1"; else say "$2"; fi; }
# port UI mengikuti penanda enabled lewat aturan auto-panel firewall: terapkan ulang setelah penanda berubah
ui_firewall() {
  # firewall host (firewalld/ufw/CSF) lebih dulu: tanpa itu UI tidak terjangkau dari jaringan walau ZySentinel mengizinkannya
  local hf=/www/server/sentinel/bin/adapters/hostfw.py
  [ -f "$hf" ] && command -v python3 >/dev/null 2>&1 && python3 -B "$hf" sync "$UI_PORT" || true
  local py=python3; [ -x /www/server/panel/pyenv/bin/python3 ] && py=/www/server/panel/pyenv/bin/python3
  [ -f /www/server/sentinel/bin/sentinel-ports.py ] && "$py" /www/server/sentinel/bin/sentinel-ports.py apply >/dev/null 2>&1
  return 0
}

ui_cmd() {
  local sub="${1:-status}" user="${2:-}" ipx fp
  case "$sub" in
    status)
      if [ ! -f "$UI_STATIC/sentinel-ui.py" ]; then ui_pesan "UI standalone belum terpasang (hanya paket Pro/Max)." "Standalone UI is not installed (Pro/Max only)."; return 1; fi
      if [ -f "$UI_ETC/enabled" ]; then ui_pesan "mode        : aktif" "mode        : enabled"; else ui_pesan "mode        : nonaktif" "mode        : disabled"; fi
      if is_systemd; then
        say "sentinel-uid : $(systemctl is-active sentinel-uid.service 2>/dev/null)"
        say "sentinel-ui  : $(systemctl is-active sentinel-ui.service 2>/dev/null)"
      fi
      if command -v curl >/dev/null 2>&1 && curl -sk --max-time 4 "https://127.0.0.1:$UI_PORT/healthz" 2>/dev/null | grep -q '^ok'; then say "healthz     : ok"; else say "healthz     : tidak menjawab"; fi
      ;;
    url)
      ipx="$(hostname -I 2>/dev/null | awk '{print $1}')"
      say "https://${ipx:-<ip-server>}:$UI_PORT"
      fp="$(openssl x509 -in "$UI_ETC/tls.crt" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2)"
      [ -n "$fp" ] && say "SHA-256: $fp"
      ;;
    enable)
      if [ ! -f "$UI_STATIC/sentinel-ui.py" ]; then err "UI standalone belum terpasang; jalankan install.sh update dari paket Pro/Max"; return 1; fi
      mkdir -p /www/server/sentinel/etc/ui; echo on >/www/server/sentinel/etc/ui/mode; chmod 600 /www/server/sentinel/etc/ui/mode
      touch "$UI_ETC/enabled"
      is_systemd && systemctl enable --now sentinel-uid.service sentinel-ui.service
      ui_firewall
      ui_pesan "UI standalone diaktifkan. Alamat:" "Standalone UI enabled. Address:"
      ui_cmd url
      ;;
    disable)
      mkdir -p /www/server/sentinel/etc/ui; echo off >/www/server/sentinel/etc/ui/mode; chmod 600 /www/server/sentinel/etc/ui/mode
      rm -f "$UI_ETC/enabled"
      is_systemd && systemctl disable --now sentinel-ui.service sentinel-uid.service
      ui_firewall
      ui_pesan "UI standalone dinonaktifkan." "Standalone UI disabled."
      ;;
    cert-renew)
      if [ ! -f "$UI_ETC/.dibuat-installer" ] && [ -s "$UI_ETC/tls.crt" ]; then
        err "sertifikat UI milik Anda (bukan buatan installer); perbarui sendiri tls.crt/tls.key di $UI_ETC"; return 1
      fi
      command -v openssl >/dev/null 2>&1 || { err "openssl tidak ada"; return 1; }
      local san="DNS:localhost,IP:127.0.0.1" h ip
      h="$(hostname -f 2>/dev/null || hostname)"; [ -n "$h" ] && san="$san,DNS:$h"
      for ip in $(hostname -I 2>/dev/null); do san="$san,IP:$ip"; done
      ( umask 077; openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 825 -subj "/CN=${h:-zysentinel}" \
          -addext "subjectAltName=$san" -keyout "$UI_ETC/tls.key.baru" -out "$UI_ETC/tls.crt.baru" >/dev/null 2>&1 ) || { err "pembuatan sertifikat gagal"; return 1; }
      mv -f "$UI_ETC/tls.key.baru" "$UI_ETC/tls.key"; mv -f "$UI_ETC/tls.crt.baru" "$UI_ETC/tls.crt"
      touch "$UI_ETC/.dibuat-installer"
      chown root:zysui "$UI_ETC/tls.key" "$UI_ETC/tls.crt"; chmod 640 "$UI_ETC/tls.key"; chmod 644 "$UI_ETC/tls.crt"
      is_systemd && systemctl restart sentinel-ui.service
      ui_pesan "sertifikat baru dibuat." "new certificate created."
      ui_cmd url
      ;;
    2fa|2fa-off)
      if ! printf '%s' "$user" | grep -Eq '^[A-Za-z0-9_][A-Za-z0-9_.-]{0,31}$' || ! id "$user" >/dev/null 2>&1; then
        err "pakai: guardctl ui $sub <akun-linux>"; return 1
      fi
      local f="/www/server/sentinel/etc/ui/totp/$user.key"
      if [ "$sub" = "2fa-off" ]; then rm -f "$f"; ui_pesan "2FA untuk $user dimatikan." "2FA disabled for $user."; return 0; fi
      command -v base32 >/dev/null 2>&1 || { err "perintah base32 (coreutils) tidak ada"; return 1; }
      mkdir -p /www/server/sentinel/etc/ui/totp; chmod 700 /www/server/sentinel/etc/ui/totp
      local sec; sec="$(head -c 20 /dev/urandom | base32 | tr -d '=\n')"
      ( umask 077; printf '%s\n' "$sec" >"$f" )
      ui_pesan "2FA aktif untuk $user. Pindai/masukkan ke aplikasi autentikator (rahasia ini hanya ditampilkan sekali):" "2FA enabled for $user. Add it to your authenticator app (shown once):"
      say "  secret : $sec"
      say "  uri    : otpauth://totp/ZySentinel:$user?secret=$sec&issuer=ZySentinel&digits=6&period=30"
      ;;
    *)
      say "pakai: guardctl ui {status|url|enable|disable|cert-renew|2fa <akun>|2fa-off <akun>}"; return 1
      ;;
  esac
}

case "${1:-}" in
  status)
    if [ -f "$STATUSJSON" ]; then
      if command -v jq >/dev/null 2>&1; then
        jq . "$STATUSJSON"
      else
        cat "$STATUSJSON"
      fi
    else
      if [ "$(get_lang)" = "id" ]; then
        err "status.json belum ada; guardd belum menulis statistik"
      else
        err "status.json not found; guardd has not written statistics yet"
      fi
      exit 1
    fi
    ;;

  brief)
    # Ringkasan satu baris, enak untuk monitoring.
    [ -f "$STATUSJSON" ] || {
      if [ "$(get_lang)" = "id" ]; then err "status.json belum ada"; else err "status.json not found"; fi
      exit 1
    }
    if command -v jq >/dev/null 2>&1; then
      # Dua angka ban sengaja dipisahkan. bans_total adalah jumlah
      # ban yang PERNAH dibuat sejak daemon mulai, sedangkan bans_active
      # adalah ban yang masih berlaku sekarang. Kalau keduanya dicampur
      # jadi satu, angka terlihat tidak pernah turun padahal ipset sudah
      # kosong.
      jq -r '"enforce=\(.enforce) log=\(.logs|length) request=\(.total_req) " +
           "bytes=\(.total_bytes) ip=\(.ips_tracked) " +
           "ban_aktif=\(.bans_active) ban_total=\(.bans_total) " +
           "throttle=\(.throttles_total) rss=\(.rss_kb)KB"' "$STATUSJSON"
    elif command -v python3 >/dev/null 2>&1; then
      python3 -c "import json; d=json.load(open('$STATUSJSON')); print('enforce=%s log=%s request=%s bytes=%s ip=%s ban_aktif=%s ban_total=%s throttle=%s rss=%sKB' % (d.get('enforce',0), len(d.get('logs',[])), d.get('total_req',0), d.get('total_bytes',0), d.get('ips_tracked',0), d.get('bans_active',0), d.get('bans_total',0), d.get('throttles_total',0), d.get('rss_kb',0)))" 2>/dev/null || cat "$STATUSJSON"
    else
      cat "$STATUSJSON"
    fi
    ;;

  ping)   ctl "ping" ;;
  ban)
    [ -n "${2:-}" ] || {
      if [ "$(get_lang)" = "id" ]; then err "pakai: guardctl ban <ip> [durasi detik]"; else err "Usage: guardctl ban <ip> [duration seconds]"; fi
      exit 1
    }
    # Durasi opsional harus benar-benar dikirim ke daemon. Kalau argumen
    # ketiga diabaikan diam-diam, nilai yang diketik di panel tidak
    # pernah berlaku dan ban selalu memakai durasi bawaan.
    if [ -n "${3:-}" ]; then
      case "$3" in
        ''|*[!0-9]*)
          if [ "$(get_lang)" = "id" ]; then err "durasi harus angka bulat: $3"; else err "duration must be an integer: $3"; fi
          exit 1
          ;;
      esac
      ctl "ban $2 $3"
    else
      ctl "ban $2"
    fi
    ;;
  unban)
    [ -n "${2:-}" ] || {
      if [ "$(get_lang)" = "id" ]; then err "pakai: guardctl unban <ip>"; else err "Usage: guardctl unban <ip>"; fi
      exit 1
    }
    ctl "unban $2"
    ;;
  unreview)
    [ -n "${2:-}" ] || {
      if [ "$(get_lang)" = "id" ]; then err "pakai: guardctl unreview <ip>"; else err "Usage: guardctl unreview <ip>"; fi
      exit 1
    }
    ctl "unreview $2"
    ;;
  allow)
    [ -n "${2:-}" ] || {
      if [ "$(get_lang)" = "id" ]; then err "pakai: guardctl allow <ip>"; else err "Usage: guardctl allow <ip>"; fi
      exit 1
    }
    ctl "allow $2"
    ;;
  rescan) ctl "rescan" ;;
  learnload) ctl "learnload" ;;
  flush)  ctl "flush" ;;

  panic|panic-on|panic-off|panic-status)
    # Panic TIDAK lewat socket daemon. Aturan iptables harus tetap bisa
    # dipasang ulang dan dicabut meski guardd sedang mati, dan justru
    # di saat panik guardd itu yang paling mungkin tidak merespons.
    FW="${SENTINEL_FW:-/www/server/sentinel/bin/sentinel-fw.sh}"
    [ -x "$FW" ] || {
      if [ "$(get_lang)" = "id" ]; then err "skrip firewall tidak ditemukan: $FW"; else err "firewall script not found: $FW"; fi
      exit 1
    }
    "$FW" "$1"
    rc=$?
    # panic-status mengembalikan 1 saat tidak aktif. Itu jawaban yang
    # benar, bukan kegagalan perintah, jadi diteruskan apa adanya.
    exit $rc
    ;;

  start)
    if is_systemd && systemctl is-active sentinel.service >/dev/null 2>&1; then
      if [ "$(get_lang)" = "id" ]; then say "sentinel.service sudah aktif dan berjalan"; else say "sentinel.service is already active and running"; fi
      exit 0
    fi
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
      if [ "$(get_lang)" = "id" ]; then say "guardd sudah aktif dan berjalan (PID $(cat "$PIDFILE"))"; else say "guardd is already active and running (PID $(cat "$PIDFILE"))"; fi
      exit 0
    fi
    if is_systemd; then
      if [ "$(get_lang)" = "id" ]; then
        systemctl start sentinel.service && say "sentinel.service berhasil dijalankan"
      else
        systemctl start sentinel.service && say "sentinel.service successfully started"
      fi
    else
      BINDIR="$(dirname "$0")"
      nohup "$BINDIR/guardd" -c "$CONF" >/dev/null 2>&1 &
      if [ "$(get_lang)" = "id" ]; then say "guardd dimulai di latar belakang"; else say "guardd started in background"; fi
    fi
    ;;

  stop)
    if is_systemd && systemctl is-active sentinel.service >/dev/null 2>&1; then
      if [ "$(get_lang)" = "id" ]; then
        systemctl stop sentinel.service && say "sentinel.service berhasil dihentikan"
      else
        systemctl stop sentinel.service && say "sentinel.service successfully stopped"
      fi
    else
      if [ "$(get_lang)" = "id" ]; then
        ctl "stop" 2>/dev/null && say "permintaan berhenti dikirim, guardd akan menutup diri" || {
          if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null && say "guardd dihentikan via PID"
          fi
        }
      else
        ctl "stop" 2>/dev/null && say "stop request sent, guardd will shut down" || {
          if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null && say "guardd stopped via PID"
          fi
        }
      fi
    fi
    # juga proses guardd di luar systemd (mis. dijalankan manual): stop baru selesai bila tidak ada guardd tersisa
    pastikan_berhenti
    ;;

  restart)
    if is_systemd; then
      if [ "$(get_lang)" = "id" ]; then
        systemctl restart sentinel.service && say "sentinel.service berhasil dimulai ulang"
      else
        systemctl restart sentinel.service && say "sentinel.service successfully restarted"
      fi
    else
      "$0" stop
      sleep 1
      "$0" start
    fi
    ;;

  reload)
    if is_systemd && systemctl is-active sentinel.service >/dev/null 2>&1; then
      if [ "$(get_lang)" = "id" ]; then
        systemctl reload sentinel.service && say "konfigurasi sentinel.service berhasil dimuat ulang (SIGHUP)"
      else
        systemctl reload sentinel.service && say "sentinel.service configuration successfully reloaded (SIGHUP)"
      fi
    elif [ -f "$PIDFILE" ]; then
      if [ "$(get_lang)" = "id" ]; then
        kill -HUP "$(cat "$PIDFILE")" 2>/dev/null && say "SIGHUP dikirim ke PID $(cat "$PIDFILE")"
      else
        kill -HUP "$(cat "$PIDFILE")" 2>/dev/null && say "SIGHUP sent to PID $(cat "$PIDFILE")"
      fi
    else
      if [ "$(get_lang)" = "id" ]; then
        ctl "rescan" 2>/dev/null && say "perintah rescan dikirim ke daemon" || err "gagal memuat ulang daemon"
      else
        ctl "rescan" 2>/dev/null && say "rescan command sent to daemon" || err "failed to reload daemon"
      fi
    fi
    ;;

  set)
    # Ubah satu key di berkas config. Menghentikan daemon dari
    # panel karena daemon membaca config hanya saat start.
    key="${2:-}"; val="${3:-}"
    [ -n "$key" ] || {
      if [ "$(get_lang)" = "id" ]; then err "pakai: guardctl set <key> <nilai>"; else err "Usage: guardctl set <key> <value>"; fi
      exit 1
    }
    if [ ! -f "$CONF" ]; then
      if [ "$(get_lang)" = "id" ]; then err "config tidak ditemukan: $CONF"; else err "config not found: $CONF"; fi
      exit 1
    fi
    # Kunci dan nilai masuk ke sed dan ke berkas konfigurasi yang dibaca daemon
    # sebagai root: tolak apa pun yang bisa menyuntikkan perintah sed ('e'),
    # baris baru, atau kunci palsu.
    case "$key" in *[!A-Za-z0-9_]*) err "key tidak valid: hanya huruf, angka, dan _"; exit 1 ;; esac
    case "$val" in *$'\n'*|*$'\r'*) err "nilai tidak boleh memuat baris baru"; exit 1 ;; esac
    before="$CONF.$(date +%Y%m%d%H%M%S).bak"
    cp -p "$CONF" "$before"
    # salinan tetap guardd.conf.bak: guardd memakainya bila guardd.conf ditemukan kosong/terpotong saat start
    [ -s "$CONF" ] && cp -p "$CONF" "$CONF.bak"
    # simpan paling banyak 5 cadangan terbaru (hanya milik berkas ini)
    ls -1t "$CONF".*.bak 2>/dev/null | tail -n +6 | while IFS= read -r old; do rm -f -- "$old"; done
    esc=$(printf '%s' "$val" | sed -e 's/[\\|&]/\\&/g')
    if grep -qE "^[[:space:]]*$key[[:space:]]*=" "$CONF"; then
      sed -i -E "s|^[[:space:]]*$key[[:space:]]*=.*|$key = $esc|" "$CONF"
    else
      printf '%s = %s\n' "$key" "$val" >> "$CONF"
    fi
    if [ "$(get_lang)" = "id" ]; then
      say "config diperbarui: $key = $val (backup: $before)"
      say "jalankan: systemctl restart sentinel"
    else
      say "config updated: $key = $val (backup: $before)"
      say "run: systemctl restart sentinel"
    fi
    ;;

  live)
    # Ikuti status.json tiap 2 detik.
    [ -f "$STATUSJSON" ] || { err "status.json belum ada"; exit 1; }
    while :; do
      clear 2>/dev/null || true
      if command -v jq >/dev/null 2>&1; then
        jq -r '"waktu      : \(.ts)  uptime=\(.uptime)s",
               "mode        : \(if .enforce==1 then "AKTIF (memblokir)" else "MONITOR (tidak memblokir)" end)",
               "request    : \(.total_req)  byte=\(.total_bytes)  baris-terbaca=\(.lines)",
               "IP dilacak  : \(.ips_tracked)",
               "log ditail  : \(.logs|length)",
               "ban total   : \(.bans_total)  throttle total: \(.throttles_total)  ban aktif: \(.bans|length)",
               "memori      : \(.rss_kb) KB",
               "ambang      : watch=\(.watch_score) throttle=\(.throttle_score) ban=\(.ban_score)",
               "--- 10 IP teratas ---",
               (.top_ips[:10][] | "  \(.ip)  req=\(.req)  skor=\(.score)  level=\(.level)"),
               "--- ban aktif ---",
               ((.bans[:10][]? | "  \(.ip)  \(.kind)  skor=\(.score)  sisa=\(.until - .ts)d") // "  (tidak ada)")' \
          "$STATUSJSON"
      else
        cat "$STATUSJSON"
      fi
      sleep 2
    done
    ;;

  check-auth)
    /www/server/panel/pyenv/bin/python3 -c "import sys; sys.path.insert(0, '/www/server/panel/plugin/sentinel'); import sentinel_main; p = sentinel_main.sentinel_main(); res = p.verify_developer_auth(); import json; print(json.dumps(res, indent=2))"
    ;;

  scan-ai)
    if [ "$(get_lang)" = "id" ]; then err "SAGE AI Safety membutuhkan paket Max (av_engines)"; else err "SAGE AI Safety requires the Max plan (av_engines)"; fi
    exit 1
    ;;

  logs)
    n="${2:-50}"
    if is_systemd && command -v journalctl >/dev/null 2>&1 && systemctl cat sentinel >/dev/null 2>&1; then
      journalctl -u sentinel -n "$n" --no-pager
    else
      tail -n "$n" /www/server/sentinel/log/guardd.log 2>/dev/null || {
        if [ "$(get_lang)" = "id" ]; then err "log tidak ditemukan"; else err "log not found"; fi
      }
    fi
    ;;

  env)
    # lingkungan terdeteksi: OS, panel, web server (versi/aktif), keadaan. --json untuk rincian lengkap.
    shift
    _py=python3; [ -x /www/server/panel/pyenv/bin/python3 ] && _py=/www/server/panel/pyenv/bin/python3
    _envpy="$(dirname "$(readlink -f "$0")")/adapters/env.py"
    [ -f "$_envpy" ] || { err "adapters/env.py tidak ditemukan"; exit 1; }
    "$_py" "$_envpy" detect "$@"
    exit $?
    ;;

  ui)
    shift
    ui_cmd "$@"
    exit $?
    ;;

  ""|help|-h|--help)
    if [ "$(get_lang)" = "id" ]; then
      cat <<'EOF'
pakai: guardctl <perintah>

  status            tampilkan status.json lengkap (format rapi)
  brief             ringkasan satu baris
  live              tampilkan langsung, diperbarui tiap 2 detik
  ping              uji daemon menjawab
  ban <ip>          blokir IP sekarang juga (dengan timeout bawaan)
  unban <ip>        lepas blokir dan hapus dari daftar
  unreview <ip>     lepas dari antrian review tanpa memblokir
  allow <ip>        whitelist permanen (bertahan setelah restart)
  rescan            paksa penemuan ulang daftar access log sekarang juga
  learnload         muat ulang pelajaran dari keputusan operator (learned.tsv)
  flush             paksa penulisan statistik ke database
  panic-on          blokir seluruh akses web (port web saja, SSH tetap aman)
  panic-off         cabut blokir panic
  panic-status      cek apakah panic sedang aktif
  stop              minta daemon berhenti rapi
  set <k> <v>       ubah satu key di guardd.conf
  logs [n]          tampilkan n baris log terakhir
  check-auth        periksa otentikasi pengembang resmi & integritas kode
  scan-ai [path]    pindai prompt injection, toxic skills & aturan AI berbahaya
  env [--json]      lingkungan terdeteksi: OS, panel, web server (versi, aktif), keadaan
  ui <sub>          UI standalone: status|url|enable|disable|cert-renew|2fa <akun>|2fa-off <akun>
EOF
    else
      cat <<'EOF'
Usage: guardctl <command>

  status            show full status.json (formatted)
  brief             one-line summary
  live              live monitor, refreshed every 2 seconds
  ping              test if daemon responds
  ban <ip>          ban IP immediately (with default timeout)
  unban <ip>        unban IP and remove from blacklist
  unreview <ip>     remove IP from review queue without banning
  allow <ip>        permanent whitelist (persists across restarts)
  rescan            force redetection of access log files now
  learnload         reload lessons learned from operator decisions (learned.tsv)
  flush             flush statistics to database
  panic-on          emergency lockdown web access (SSH remains accessible)
  panic-off         disable panic lockdown
  panic-status      check if panic mode is active
  stop              request daemon graceful shutdown
  set <k> <v>       update a config key in guardd.conf
  logs [n]          display last n log lines
  check-auth        verify developer authority & code integrity
  scan-ai [path]    scan for prompt injection, toxic skills & dangerous AI rules
  env [--json]      detected environment: OS, panel, web server (version, active), state
  ui <sub>          standalone UI: status|url|enable|disable|cert-renew|2fa <user>|2fa-off <user>
EOF
    fi
    ;;

  *)
    if [ "$(get_lang)" = "id" ]; then
      err "perintah tidak dikenal: $1 (lihat: guardctl help)"; exit 1
    else
      err "unknown command: $1 (see: guardctl help)"; exit 1
    fi
    ;;
esac

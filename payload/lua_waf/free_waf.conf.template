# ZySentinel Embedded WAF Engine (Nginx Lua)
# Terintegrasi penuh sebagai modul pertahanan bawaan plugin ZySentinel.
#
# BATAS KERAS (nginx menolak start bila dilanggar):
#  - access_by_lua_file hanya boleh SATU per level HTTP.
#  - lua_package_path hanya boleh SATU per level HTTP.

lua_shared_dict sentinel_waf 20m;
lua_shared_dict sentinel_waf_drop_ip 10m;
lua_shared_dict sentinel_waf_drop_sum 10m;
lua_shared_dict sentinel_waf_stat 5m;
lua_shared_dict sentinel_waf_stat_lock 1m;

init_by_lua_file   /www/server/sentinel/waf/free_waf/init.lua;
access_by_lua_file /www/server/sentinel/waf/free_waf/waf.lua;

#!/bin/bash
# chkconfig: 2345 55 25
# description: ZySentinel guardd security monitoring daemon
### BEGIN INIT INFO
# Provides:          sentinel
# Required-Start:    $all
# Required-Stop:     $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: starts ZySentinel daemon
# Description:       starts ZySentinel background guardd service
### END INIT INFO

SENTINEL_HOME="/www/server/sentinel"
GUARDCTL="$SENTINEL_HOME/bin/guardctl"

IS_SYSTEMD=0
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
  IS_SYSTEMD=1
fi

case "$1" in
  start)
    if [ "$IS_SYSTEMD" -eq 1 ]; then
      systemctl start sentinel.service
    elif [ -x "$GUARDCTL" ]; then
      $GUARDCTL start
    else
      echo "sentinel binary not found" >&2
      exit 1
    fi
    ;;
  stop)
    if [ "$IS_SYSTEMD" -eq 1 ]; then
      systemctl stop sentinel.service
    elif [ -x "$GUARDCTL" ]; then
      $GUARDCTL stop
    fi
    ;;
  restart)
    if [ "$IS_SYSTEMD" -eq 1 ]; then
      systemctl restart sentinel.service
    elif [ -x "$GUARDCTL" ]; then
      $GUARDCTL restart
    fi
    ;;
  reload|force-reload)
    if [ "$IS_SYSTEMD" -eq 1 ]; then
      systemctl reload sentinel.service
    elif [ -x "$GUARDCTL" ]; then
      $GUARDCTL reload
    fi
    ;;
  status)
    if [ "$IS_SYSTEMD" -eq 1 ]; then
      systemctl status sentinel.service
    elif [ -x "$GUARDCTL" ]; then
      $GUARDCTL status
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/sentinel {start|stop|restart|reload|status}" >&2
    exit 1
    ;;
esac
exit 0
